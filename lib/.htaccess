# NEGAR acceso web directo a esta carpeta.
# El código PHP la sigue pudiendo usar por filesystem (require/include/readfile).
# Los archivos se sirven siempre vía scripts con control de login/rol
# (ej: adjunto_ver.php, changelog_descargar.php, admin_backup_descargar.php).
Options -Indexes
ServerSignature Off
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
